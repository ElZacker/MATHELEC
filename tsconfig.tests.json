{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".test-build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "tests/simulation.test.ts",
    "lib/circuits/simulation.ts",
    "lib/circuits/types.ts",
    "tests/wire-routing.test.ts",
    "lib/circuits/wire-routing.ts",
    "tests/known-circuit-templates.test.ts",
    "lib/circuits/known-circuit-templates.ts",
    "lib/circuits/components.ts",
    "lib/circuits/transient-simulation.ts",
    "tests/native-eda-formats.test.ts",
    "lib/eda/native-project-inspector.ts",
    "tests/eda-compatibility-matrix.test.ts",
    "lib/eda/compatibility-matrix.ts"
  ]
}
